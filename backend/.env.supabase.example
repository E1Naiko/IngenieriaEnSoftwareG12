# Plantilla para PRODUCCIÓN. Es un proyecto Supabase distinto al de desarrollo.
# Cargar estas variables como secretos del proveedor de hosting; no guardar
# credenciales reales en Git. Supabase Dashboard -> Connect -> Session pooler.
DATABASE_MODE=postgres
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_SSLMODE=require

# Reemplazar todos los valores de ejemplo antes de desplegar.
DJANGO_SECRET_KEY=<generate-a-unique-secret-key>
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com
