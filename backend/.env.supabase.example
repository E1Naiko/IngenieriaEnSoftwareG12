# Plantilla para PRODUCCIÓN. Es un proyecto Supabase distinto al de desarrollo.
# Cargar estas variables como secretos del proveedor de hosting; no guardar
# credenciales reales en Git. Supabase Dashboard -> Connect -> Session pooler.
DATABASE_MODE=postgres
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<project-ref>
DB_PASSWORD=<database-password>
DB_SSLMODE=require

# Reemplazar todos los valores de ejemplo antes de desplegar.
DJANGO_SECRET_KEY=<generate-a-unique-secret-key>
DJANGO_DEBUG=False
# Sin barra final ni path: django-cors-headers aborta el arranque si el origen trae path (E014).
DJANGO_ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://app.example.com

# Oferta a repartidores cercanos: tiempo máximo y distancia al punto de retiro.
REASIGNACION_MINUTOS=15
REASIGNACION_RADIO_KM=5
# Necesario si un proxy cambia el host o termina HTTPS antes de Django.
# Especificar el origen público del frontend (esquema + host, sin barra final).
CSRF_TRUSTED_ORIGINS=https://app.example.com
