# ==========================================================================
# Credenciales de la base de datos PostgreSQL de Supabase.
# Copiar este archivo como ".env" (sin .example) y completar los valores.
#
# ¿Dónde se sacan? En https://supabase.com/dashboard ->
#   tu proyecto -> botón "Connect" (barra superior) -> sección "Session pooler"
#   (recomendada: funciona por IPv4 y es compatible con cualquier red).
# La contraseña es la que eligieron al crear el proyecto.
#
# IMPORTANTE: el archivo .env NO se sube a Git (ya está en .gitignore).
# Si dejan DB_HOST vacío, Django usa una SQLite local para pruebas.
# ==========================================================================

DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<id-del-proyecto>
DB_PASSWORD=<contrasenia-de-la-base>

# --------------------------------------------------------------------------
# Opcionales (tienen valores por defecto razonables para desarrollo)
# --------------------------------------------------------------------------

# Clave secreta de Django. En producción generar una propia, por ejemplo con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=

# True en desarrollo, False en producción
DJANGO_DEBUG=True

# Hosts que puede servir Django, separados por coma.
# En desarrollo con DEBUG=True se acepta cualquier host si se deja vacío.
DJANGO_ALLOWED_HOSTS=

# Orígenes del frontend que pueden llamar a la API (CORS), separados por coma.
# Ejemplo: http://localhost:5173,http://localhost:3000
# Vacío + DEBUG=True => se aceptan todos los orígenes (solo para desarrollo).
CORS_ALLOWED_ORIGINS=
