# Desarrollo: credenciales del proyecto Supabase DE DESARROLLO.
# No reutilizar las credenciales del proyecto de producción.
# Supabase Dashboard -> Connect -> Session pooler.
# Reemplazar todos los valores de ejemplo antes de ejecutar Django.
DATABASE_MODE=postgres
DB_HOST=aws-0-<region>.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.<development-project-ref>
DB_PASSWORD=<development-database-password>
DB_SSLMODE=require

# Configuración local de Django.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# Alternativa offline (sin Supabase): cambiar DATABASE_MODE=sqlite.
# DB_SQLITE_PATH vacío usa backend/db.sqlite3.
DB_SQLITE_PATH=
